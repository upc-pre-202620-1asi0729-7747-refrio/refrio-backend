# Copia como .env y cambia TODOS los secretos. Nunca subas .env.
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters-for-jwt-signing
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password-123
CORS_ORIGINS=http://localhost:4200
SEED_DEMO=true
ALLOW_PUBLIC_SUPERVISOR_SIGNUP=false

# External service: review Open-Meteo commercial usage terms before release.
EXTERNAL_WEATHER_ENABLED=true
EXTERNAL_WEATHER_BASE_URL=https://api.open-meteo.com

# Mandatory only if SEED_DEMO=true. Demo retailer login: bodega-demo.
DEMO_RETAIL_PASSWORD=replace-with-a-strong-demo-password-123
